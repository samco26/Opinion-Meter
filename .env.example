# Keys the SERVER needs. Copy to server/.env.local for local work, or set them
# in Vercel's Environment Variables. Names only here, never values.
# Nothing in this file is ever used by the extension.

# --- AI (required for any live answer) ---
# From https://platform.openai.com/api-keys. Set a hard monthly spend cap in
# the OpenAI dashboard before the first public install.
OPENAI_API_KEY=
# Also accepts CHATGPT (the owner's Vercel variable); when set it takes precedence.
# Small, cheap model for naming subjects and the lite gauge.
LITE_MODEL=
# Capable model for the full card. Chosen by running the golden set.
CARD_MODEL=

# --- Memory (Upstash Redis via the Vercel Marketplace, or Vercel KV) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Hours an answer is kept before a background refresh. README says 24.
CACHE_TTL_HOURS=24

# --- Sources ---
# YouTube Data API v3 key (Google Cloud console). Prefer by-ID comment reads;
# a search costs 100 of the 10,000 daily quota units.
YOUTUBE_API_KEY=
# Also accepts YOUTUBE (the owner's Vercel variable); when set it takes precedence.
# Hacker News and Bluesky need no key.
# Reddit: only after the NEW application for this project is approved.
# Register the app at https://www.reddit.com/prefs/apps first.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:opinion-meter:v0.1.0 (by /u/your_username)
REDDIT_MAX_POSTS=10
REDDIT_COMMENTS_PER_POST=12
# X is off by default (a budget of 0). If enabled, only for the full card
# on click, at most X_MAX_RESULTS posts per subject, about half a cent each.
X_BEARER_TOKEN=
X_DAILY_POST_BUDGET=0
X_MAX_RESULTS=20

# --- Limits (abuse prevention) ---
# Requests per install token per minute, and per day.
RATE_PER_TOKEN_MINUTE=20
RATE_PER_TOKEN_DAY=500
# Global ceiling on fresh (uncached) subjects analysed per day.
FRESH_SUBJECTS_PER_DAY=5000
# Fewer on-topic opinions than this and there is no verdict.
MIN_ITEMS=8

# --- Bluesky (optional) ---
# Bluesky's public search door sometimes refuses server requests. A normal
# Bluesky account plus an app password (Settings → Privacy and security →
# App passwords) lets the server search while signed in.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
